# 复制本文件为 .env 后填写。没有 API Key 时，Demo 会自动使用本地模板生成。

# 通用 OpenAI-compatible 配置，推荐优先使用这一组。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# DeepSeek 示例：
# LLM_API_KEY=你的 DeepSeek API Key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=从 DeepSeek 控制台或官方文档复制的模型名

# 如果你使用 OpenAI 官方接口，也可以使用下面这组变量。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 也兼容常见国产大模型厂商的 API Key 变量名。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=
